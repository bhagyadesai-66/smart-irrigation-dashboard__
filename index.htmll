<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Crop Irrigation Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style>
    :root {
      --bg1: #1b5e20;
      --bg2: #4caf50;
      --card: rgba(255,255,255,.15);
      --text: #fff;
      --accent: #ffeb3b;
    }

    body.dark {
      --bg1: #101820;
      --bg2: #263238;
      --card: rgba(255,255,255,.09);
      --text: #f5f5f5;
      --accent: #80cbc4;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 16px;
      font-family: Arial, sans-serif;
      color: var(--text);
      background: linear-gradient(135deg, var(--bg1), var(--bg2));
    }

    header, .topbar, .dashboard, .chart-container {
      max-width: 1100px;
      margin: 20px auto;
    }

    header { text-align: center; }
    h1 { font-size: 28px; }
    .subtitle, .small { opacity: .85; }
    .small { font-size: 13px; }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .dashboard {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
    }

    .card, .chart-container {
      background: var(--card);
      border-radius: 16px;
      padding: 20px;
      text-align: center;
      box-shadow: 0 4px 10px rgba(0,0,0,.12);
      min-width: 0;
    }

    .card h2, .chart-container h2 {
      font-size: 17px;
      margin-top: 0;
    }

    .value {
      font-size: 30px;
      font-weight: bold;
      margin: 12px 0;
      overflow-wrap: anywhere;
    }

    .status {
      max-width: 700px;
      margin: 20px auto;
      padding: 14px;
      text-align: center;
      border-radius: 12px;
      font-weight: bold;
      background: #2e7d32;
    }

    .status.warning { background: #a65e00; }
    .status.danger { background: #b71c1c; }

    .pump {
      text-align: center;
      margin: 20px;
      font-size: 18px;
    }

    .pump-indicator {
      display: inline-block;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      margin-right: 8px;
      background: #757575;
    }

    .pump-indicator.on { background: #00e676; }

    button, input, select { font: inherit; }

    button {
      border: 0;
      border-radius: 8px;
      padding: 11px 16px;
      margin: 5px;
      background: var(--accent);
      color: #17351c;
      font-weight: bold;
      cursor: pointer;
    }

    button:focus-visible, input:focus-visible, select:focus-visible {
      outline: 3px solid white;
      outline-offset: 3px;
    }

    button:disabled {
      opacity: .5;
      cursor: not-allowed;
    }

    input, select {
      width: 100%;
      padding: 10px;
      border: 1px solid #aaa;
      border-radius: 8px;
      margin: 7px 0 14px;
      background: #fff;
      color: #17251a;
    }

    input[type="range"] {
      padding: 0;
      accent-color: var(--accent);
    }

    label {
      display: block;
      text-align: left;
      font-size: 14px;
    }

    .chart-container { max-width: 800px; }
    .chart-wrap { position: relative; height: 260px; }
    .section-title { text-align: center; margin-top: 35px; }
    .footer { text-align: center; font-size: 12px; opacity: .8; margin: 30px auto; }

    .doctor-card {
      border: 1px solid rgba(255,255,255,.35);
    }

    .doctor-card .value { font-size: 23px; }

    @media(max-width: 480px) {
      body { padding: 10px; }
      h1 { font-size: 23px; }
      .card, .chart-container { padding: 16px; }
      .chart-wrap { height: 220px; }
    }
  </style>
</head>

<body>
  <header>
    <h1>🌱 Smart Crop Irrigation Dashboard</h1>
    <p class="subtitle">Smart water monitoring and irrigation control</p>
  </header>

  <div class="topbar">
    <div>
      <strong id="clock">--:--:--</strong>
      <div class="small" id="date">Loading date...</div>
    </div>
    <button id="themeButton">🌙 Dark Mode</button>
  </div>

  <div class="dashboard">
    <div class="card">
      <h2>Soil Moisture</h2>
      <div class="value" id="moisture">50%</div>
      <p id="soilStatus">Soil: Moist</p>
      <input type="range" id="moistureSlider" min="0" max="100" value="50"
        aria-label="Simulated soil moisture">
      <div class="small">Move slider to test readings</div>
    </div>

    <div class="card">
      <h2>Temperature</h2>
      <div class="value" id="temperature">28°C</div>
      <div class="small">Simulated reading</div>
    </div>

    <div class="card">
      <h2>Humidity</h2>
      <div class="value" id="humidity">60%</div>
      <div class="small">Simulated reading</div>
    </div>

    <div class="card">
      <h2>Water Tank</h2>
      <div class="value" id="tankValue">80%</div>
      <input type="range" id="tankSlider" min="0" max="100" value="80"
        aria-label="Simulated tank level">
      <p id="tankStatus">Tank level: Good</p>
    </div>

    <div class="card">
      <h2>Water Usage</h2>
      <div class="value"><span id="waterUsage">0.0</span> L</div>
      <button id="resetUsageButton">Reset Usage</button>
    </div>

    <div class="card">
      <h2>🌧️ Rain Detection</h2>
      <div class="value" id="rainStatus">No Rain</div>
      <button id="rainButton">Simulate Rain</button>
      <p class="small">Rain pauses simulated irrigation.</p>
    </div>

    <div class="card">
      <h2>💧 Estimated Water Saved</h2>
      <div class="value"><span id="waterSaved">0.0</span> L</div>
      <p class="small">Illustrative demo estimate.</p>
    </div>

    <div class="card">
      <h2>Plant Status</h2>
      <div class="value" id="plantHealth">Good</div>
      <p id="plantMessage">Soil conditions look suitable.</p>
    </div>

    <div class="card">
      <h2>🌱 Plant Profile</h2>
      <label for="plantProfile">Choose your crop</label>
      <select id="plantProfile">
        <option value="tomato">Tomato</option>
        <option value="rice">Rice</option>
        <option value="chilli">Chilli</option>
        <option value="groundnut">Groundnut</option>
      </select>
      <p class="small" id="profileInfo">Ideal moisture: 50–70%</p>
      <p class="small">Crop targets are simplified demo settings.</p>
    </div>

    <div class="card doctor-card">
      <h2>🩺 Smart Plant Doctor</h2>
      <div class="value" id="doctorTitle">Checking...</div>
      <p id="doctorAdvice">Advice will appear here.</p>
      <button id="doctorButton">Get New Advice</button>
      <p class="small">Educational advice based on simulated readings.</p>
    </div>
  </div>

  <div class="status" id="statusBox" aria-live="polite">System ready</div>

  <div class="pump">
    <span class="pump-indicator" id="pumpIndicator"></span>
    <span id="pumpText">Pump: OFF</span>
  </div>

  <h2 class="section-title">💧 Irrigation Control</h2>
  <div class="dashboard">
    <div class="card">
      <h2>Operating Mode</h2>
      <button id="autoButton">Automatic</button>
      <button id="manualButton">Manual</button>
      <p id="modeText">Mode: Automatic</p>
      <button id="pumpButton" disabled>Turn Pump ON / OFF</button>
      <p class="small">Simulated pump only. No real hardware connected.</p>
    </div>

    <div class="card">
      <h2>Irrigation Schedule</h2>
      <label for="scheduleTime">Start time</label>
      <input type="time" id="scheduleTime" value="06:00">
      <label for="duration">Duration (minutes)</label>
      <input type="number" id="duration" min="1" max="60" value="5">
      <button id="saveScheduleButton">Save Schedule</button>
      <button id="clearScheduleButton">Clear Schedule</button>
      <p id="scheduleStatus">No schedule saved</p>
    </div>

    <div class="card">
      <h2>Sensor Controls</h2>
      <button id="randomButton">🔄 Random Reading</button>
      <button id="csvButton">📥 Download CSV</button>
      <p class="small">Download simulated sensor history as a CSV file.</p>
    </div>
  </div>

  <div class="chart-container">
    <h2>📈 Soil Moisture Trend</h2>
    <div class="chart-wrap"><canvas id="moistureChart"></canvas></div>
  </div>

  <div class="chart-container">
    <h2>💧 Water Usage Trend</h2>
    <div class="chart-wrap"><canvas id="waterChart"></canvas></div>
  </div>

  <div class="footer">
    Educational project • Simulated data • Not connected to real irrigation equipment
  </div>

  <script>
    // Crop targets are simplified demo values, not agronomic recommendations.
    const plantProfiles = {
      tomato: {
        name: "Tomato",
        low: 30,
        high: 60,
        ideal: "50–70%"
      },
      rice: {
        name: "Rice",
        low: 40,
        high: 75,
        ideal: "60–80%"
      },
      chilli: {
        name: "Chilli",
        low: 30,
        high: 60,
        ideal: "50–70%"
      },
      groundnut: {
        name: "Groundnut",
        low: 25,
        high: 55,
        ideal: "45–65%"
      }
    };

    // Illustrative demo flow rate. Water usage changes by this amount per minute.
    const WATER_RATE_L_PER_MIN = 1;

    let mode = "auto";
    let pumpOn = false;
    let currentMoisture = 50;
    let tankLevel = 80;
    let waterUsage = 0;
    let waterSaved = 0;
    let rainDetected = false;
    let selectedCrop = "tomato";
    let schedule = null;
    let scheduleStarted = false;
    let scheduleStartTimestamp = null;
    let lastScheduleDate = "";
    let history = [];

    const $ = id => document.getElementById(id);

    const chartOptions = {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          ticks: { color: "#fff" }
        },
        x: {
          ticks: { color: "#fff", maxRotation: 0 }
        }
      },
      plugins: {
        legend: { labels: { color: "#fff" } }
      }
    };

    const moistureChart = new Chart($("moistureChart"), {
      type: "line",
      data: {
        labels: [],
        datasets: [{
          label: "Soil Moisture (%)",
          data: [],
          borderColor: "#ffeb3b",
          backgroundColor: "rgba(255,235,59,.2)",
          tension: .3,
          fill: true
        }]
      },
      options: {
        ...chartOptions,
        scales: {
          ...chartOptions.scales,
          y: {
            min: 0,
            max: 100,
            ticks: { color: "#fff" }
          }
        }
      }
    });

    const waterChart = new Chart($("waterChart"), {
      type: "line",
      data: {
        labels: [],
        datasets: [{
          label: "Water Usage (L)",
          data: [],
          borderColor: "#80cbc4",
          backgroundColor: "rgba(128,203,196,.2)",
          tension: .3,
          fill: true
        }]
      },
      options: chartOptions
    });

    function addChartPoint(chart, value) {
      chart.data.labels.push(new Date().toLocaleTimeString());
      chart.data.datasets[0].data.push(value);

      if (chart.data.labels.length > 20) {
        chart.data.labels.shift();
        chart.data.datasets[0].data.shift();
      }

      chart.update();
    }

    function updateClock() {
      const now = new Date();
      $("clock").textContent = now.toLocaleTimeString();
      $("date").textContent = now.toLocaleDateString(undefined, {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric"
      });
    }

    function saveHistory() {
      history.push({
        time: new Date().toLocaleString(),
        crop: plantProfiles[selectedCrop].name,
        moisture: currentMoisture,
        temperature: $("temperature").textContent,
        humidity: $("humidity").textContent,
        tank: tankLevel.toFixed(1),
        rain: rainDetected ? "Yes" : "No",
        pump: pumpOn ? "ON" : "OFF",
        usage: waterUsage.toFixed(2),
        estimatedSaved: waterSaved.toFixed(2)
      });

      if (history.length > 500) history
